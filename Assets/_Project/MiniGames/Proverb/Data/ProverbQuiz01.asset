  m_Script: {fileID: 11500000, guid: b047510e6f046704e9983f6ec341feb8, type: 3}
  m_Name: ProverbQuiz01
  m_EditorClassIdentifier: Assembly-CSharp::IntellectualGame.Core.QuizLevelData
  title: "\u0420\u0435\u0431\u0443\u0441-\u043F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u0430"
  winMessage: "\u0412\u0441\u044F \u043D\u0430\u0440\u043E\u0434\u043D\u0430\u044F \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u044C \u0441\u043E\u0431\u0440\u0430\u043D\u0430!"
  randomize: 1
  questionCount: 4
  optionCount: 4
  questions:
  - text: "\u0414\u043E\u043F\u0438\u0448\u0438 \u043F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u0443:\n\u0410\u0442 \u2014 \u0436\u0438\u0433\u0438\u0442\u0442\u0438\u043D ___"
    correct: "\u043A\u0430\u043D\u0430\u0442\u044B"
    wrong:
    - "\u043A\u04E9\u0437\u04AF"
    - "\u0436\u043E\u043B\u0443"
    - "\u0442\u0438\u043B\u0438"
    note: "\u041A\u043E\u043D\u044C \u2014 \u043A\u0440\u044B\u043B\u044C\u044F \u0434\u0436\u0438\u0433\u0438\u0442\u0430."
  - text: "\u0414\u043E\u043F\u0438\u0448\u0438 \u043F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u0443:\n\u0416\u0435\u0442\u0438 \u04E9\u043B\u0447\u04E9\u043F, \u0431\u0438\u0440 ___"
    correct: "\u043A\u0435\u0441"
    wrong:
    - "\u0431\u0435\u0440"
    - "\u0430\u043B"
    - "\u0430\u0439\u0442"
    note: "\u0421\u0435\u043C\u044C \u0440\u0430\u0437 \u043E\u0442\u043C\u0435\u0440\u044C, \u043E\u0434\u0438\u043D \u0440\u0430\u0437 \u043E\u0442\u0440\u0435\u0436\u044C."
  - text: "\u0414\u043E\u043F\u0438\u0448\u0438 \u043F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u0443:\n\u0416\u0430\u043A\u0448\u044B \u0441\u04E9\u0437 \u2014 \u0436\u0430\u0440\u044B\u043C ___"
    correct: "\u044B\u0440\u044B\u0441"
    wrong:
    - "\u04E9\u043C\u04AF\u0440"
    - "\u0431\u0430\u0439\u043B\u044B\u043A"
    - "\u0434\u043E\u0441"
    note: "\u0414\u043E\u0431\u0440\u043E\u0435 \u0441\u043B\u043E\u0432\u043E \u2014 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u0441\u0447\u0430\u0441\u0442\u044C\u044F."
  - text: "\u0414\u043E\u043F\u0438\u0448\u0438 \u043F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u0443:\n\u0411\u0438\u0440\u0434\u0438\u043A \u0431\u043E\u043B\u0431\u043E\u0439, ___ \u0431\u043E\u043B\u0431\u043E\u0439\u0442"
    correct: "\u0442\u0438\u0440\u0434\u0438\u043A"
    wrong:
    - "\u0431\u04AF\u0442\u04AF\u043D\u0434\u04AF\u043A"
    - "\u0431\u0430\u0439\u043B\u044B\u043A"
    - "\u0442\u044B\u043D\u0447\u0442\u044B\u043A"
    note: "\u0411\u0435\u0437 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0430 \u043D\u0435 \u0431\u044B\u0432\u0430\u0435\u0442 \u0436\u0438\u0437\u043D\u0438."

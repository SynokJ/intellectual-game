  m_Script: {fileID: 11500000, guid: b047510e6f046704e9983f6ec341feb8, type: 3}
  m_Name: ManasQuiz01
  m_EditorClassIdentifier: Assembly-CSharp::IntellectualGame.Core.QuizLevelData
  title: "\u041C\u0430\u043D\u0430\u0441: \u043F\u0443\u0442\u044C \u0433\u0435\u0440\u043E\u044F"
  winMessage: "\u0413\u0435\u0440\u043E\u0439 \u0434\u043E\u0448\u0451\u043B \u0434\u043E \u044E\u0440\u0442\u044B!"
  randomize: 1
  questionCount: 5
  optionCount: 4
  questions:
  - text: "\u041A\u0430\u043A \u0437\u043E\u0432\u0443\u0442 \u043A\u043E\u043D\u044F \u041C\u0430\u043D\u0430\u0441\u0430?"
    correct: "\u0410\u043A-\u041A\u0443\u043B\u0430"
    wrong:
    - "\u0422\u0443\u043B\u043F\u0430\u0440"
    - "\u0410\u0440\u0433\u044B\u043C\u0430\u043A"
    - "\u041A\u0430\u0440\u0430-\u0416\u043E\u0440\u0433\u043E"
    note: "\u0410\u043A-\u041A\u0443\u043B\u0430 \u2014 \u0432\u0435\u0440\u043D\u044B\u0439 \u043A\u043E\u043D\u044C \u0431\u043E\u0433\u0430\u0442\u044B\u0440\u044F \u041C\u0430\u043D\u0430\u0441\u0430."
  - text: "\u041A\u0430\u043A \u0437\u043E\u0432\u0443\u0442 \u0436\u0435\u043D\u0443 \u041C\u0430\u043D\u0430\u0441\u0430?"
    correct: "\u041A\u0430\u043D\u044B\u043A\u0435\u0439"
    wrong:
    - "\u0410\u0439\u0447\u04AF\u0440\u04E9\u043A"
    - "\u0411\u0435\u0440\u043C\u0435\u0442"
    - "\u0417\u0430\u0440\u0438\u043D\u0430"
    note: "\u041A\u0430\u043D\u044B\u043A\u0435\u0439 \u2014 \u043C\u0443\u0434\u0440\u0430\u044F \u0436\u0435\u043D\u0430 \u041C\u0430\u043D\u0430\u0441\u0430."
  - text: "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u0447\u0430\u0441\u0442\u0435\u0439 \u0432 \u0442\u0440\u0438\u043B\u043E\u0433\u0438\u0438 \u043E \u041C\u0430\u043D\u0430\u0441\u0435, \u0421\u0435\u043C\u0435\u0442\u0435\u0435 \u0438 \u0421\u0435\u0439\u0442\u0435\u043A\u0435?"
    correct: 3
    wrong:
    - 2
    - 4
    - 5
    note: "\u0422\u0440\u0438\u043B\u043E\u0433\u0438\u044F: \xAB\u041C\u0430\u043D\u0430\u0441\xBB, \xAB\u0421\u0435\u043C\u0435\u0442\u0435\u0439\xBB, \xAB\u0421\u0435\u0439\u0442\u0435\u043A\xBB."
  - text: "\u041A\u0430\u043A \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u0441\u043A\u0430\u0437\u0438\u0442\u0435\u043B\u0435\u0439 \u044D\u043F\u043E\u0441\u0430 \xAB\u041C\u0430\u043D\u0430\u0441\xBB?"
    correct: "\u041C\u0430\u043D\u0430\u0441\u0447\u044B"
    wrong:
    - "\u041A\u043E\u043C\u0443\u0437\u0447\u0443"
    - "\u0410\u043A\u044B\u043D"
    - "\u0427\u0430\u0431\u0430\u043D"
    note: "\u041C\u0430\u043D\u0430\u0441\u0447\u044B \u0438\u0441\u043F\u043E\u043B\u043D\u044F\u044E\u0442 \u044D\u043F\u043E\u0441 \u043D\u0430\u0438\u0437\u0443\u0441\u0442\u044C."
  - text: "\u041A\u0430\u043A \u0437\u043E\u0432\u0443\u0442 \u0441\u044B\u043D\u0430 \u041C\u0430\u043D\u0430\u0441\u0430?"
    correct: "\u0421\u0435\u043C\u0435\u0442\u0435\u0439"
    wrong:
    - "\u0421\u0435\u0439\u0442\u0435\u043A"
    - "\u0411\u0430\u043A\u0430\u0439"
    - "\u0410\u043B\u043C\u0430\u043C\u0431\u0435\u0442"
    note: "\u0421\u044B\u043D \u041C\u0430\u043D\u0430\u0441\u0430 \u2014 \u0421\u0435\u043C\u0435\u0442\u0435\u0439, \u0430 \u0432\u043D\u0443\u043A \u2014 \u0421\u0435\u0439\u0442\u0435\u043A."
  - text: "\u041A\u0442\u043E \u0431\u044B\u043B \u043C\u0443\u0434\u0440\u044B\u043C \u0441\u043E\u0432\u0435\u0442\u043D\u0438\u043A\u043E\u043C \u041C\u0430\u043D\u0430\u0441\u0430?"
    correct: "\u0411\u0430\u043A\u0430\u0439"
    wrong:
    - "\u0421\u0435\u043C\u0435\u0442\u0435\u0439"
    - "\u0421\u0435\u0439\u0442\u0435\u043A"
    - "\u041A\u0430\u043D\u044B\u043A\u0435\u0439"
    note: "\u0411\u0430\u043A\u0430\u0439 \u2014 \u043C\u0443\u0434\u0440\u044B\u0439 \u0441\u043E\u0432\u0435\u0442\u043D\u0438\u043A \u0438 \u0434\u0440\u0443\u0433 \u041C\u0430\u043D\u0430\u0441\u0430."
